# Create a bot via https://t.me/BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Your Telegram chat ID (see README). Optional if you use /start on the bot.
TELEGRAM_CHAT_ID=

# How often to poll John Lewis (seconds). 2–3 gives near-instant alerts.
POLL_INTERVAL_SECONDS=2

# Path to watchlist YAML (default: config.yaml)
CONFIG_PATH=config.yaml
